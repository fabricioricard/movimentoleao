rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function logado() { return request.auth != null; }

    // users/{uid}: liga a identidade anônima do navegador ao nick.
    match /users/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create: if logado() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // players/{nick em minúsculas}: o id do documento garante que o nick é único.
    match /players/{key} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.uid == request.auth.uid
        && key.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.unlocked.size() == 1
        && request.resource.data.get('pontos', 1000) == 1000;
      // Dono atual altera seus dados; ou quem prova o código de recuperação só troca o campo "uid" (nick recuperado).
      allow update: if logado()
        && request.resource.data.nick == resource.data.nick
        && (
          (resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid && pontosOk())
          || recuperacaoOk(key)
        );
      allow delete: if false;
    }

    // recuperar/{uid}: pedido temporário com o código digitado; as regras comparam o SHA-256 dele com players/{nick}.rec.
    match /recuperar/{u} {
      allow read, delete: if logado() && request.auth.uid == u;
      allow create, update: if logado() && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['chave', 'codigo']);
    }
    function recuperacaoOk(key) {
      let r = /databases/$(db)/documents/recuperar/$(request.auth.uid);
      return resource.data.get('rec', '') != ''
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && exists(r)
        && get(r).data.chave == key
        && hashing.sha256(get(r).data.codigo).toHexString() == resource.data.rec;
    }

    // Pontos do ranking: só mudam junto com um resultado de partida (results/{partida}_{uid}), uma vez por partida.
    function rid() { return request.resource.data.get('ultima', '') + '_' + request.auth.uid; }
    function pontosOk() {
      let a = resource.data.get('pontos', 1000);
      let d = request.resource.data.get('pontos', 1000);
      return a == d || (
        d >= 0
        && !exists(/databases/$(db)/documents/results/$(rid()))
        && getAfter(/databases/$(db)/documents/results/$(rid())).data.delta == d - a);
    }

    // Resultados: vitória vale +25, derrota de 0 a −15; o id impede contar a mesma partida duas vezes.
    match /results/{r} {
      allow read: if logado() && resource.data.uid == request.auth.uid;
      allow create: if logado()
        && request.resource.data.uid == request.auth.uid
        && r == request.resource.data.match + '_' + request.auth.uid
        && request.resource.data.win is bool
        && request.resource.data.delta is number
        && (request.resource.data.win ? request.resource.data.delta == 25
            : (request.resource.data.delta <= 0 && request.resource.data.delta >= -15))
        && (get(/databases/$(db)/documents/matches/$(request.resource.data.match)).data.a.uid == request.auth.uid
            || get(/databases/$(db)/documents/matches/$(request.resource.data.match)).data.b.uid == request.auth.uid);
      allow update, delete: if false;
    }

    // Fila de espera.
    match /queue/{uid} {
      allow read: if logado();
      allow create: if logado() && request.auth.uid == uid && request.resource.data['size'] == 3;
      allow update: if logado() && (
        request.auth.uid == uid ||
        (resource.data.status == 'waiting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'matchId']))
      );
      allow delete: if logado() && request.auth.uid == uid;
    }

    // Partidas e movimentos: só os dois jogadores leem e escrevem. Movimentos nunca mudam.
    match /matches/{id} {
      allow read: if logado() && (resource.data.a.uid == request.auth.uid || resource.data.b.uid == request.auth.uid);
      allow create: if logado() && request.resource.data.a.uid == request.auth.uid
        && request.resource.data.a.time.size() == 3 && request.resource.data.b.time.size() == 3;
      allow update, delete: if false;

      match /moves/{n} {
        allow read: if logado() && (
          get(/databases/$(db)/documents/matches/$(id)).data.a.uid == request.auth.uid ||
          get(/databases/$(db)/documents/matches/$(id)).data.b.uid == request.auth.uid);
        allow create: if logado() && request.resource.data.uid == request.auth.uid && (
          get(/databases/$(db)/documents/matches/$(id)).data.a.uid == request.auth.uid ||
          get(/databases/$(db)/documents/matches/$(id)).data.b.uid == request.auth.uid);
        allow update, delete: if false;
      }
    }
  }
}